<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpaceMmo.Spike</RootNamespace>
    <AssemblyName>SpaceMmoSpike</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- Renders without a display, for screenshots and frame timing. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../client-core/SpaceMmo.ClientCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- Themes are data files, loaded and swapped at runtime. -->
    <None Include="themes\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
